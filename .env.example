# Copy to .env.local and fill in real values. Never commit .env.local.

# Required for the /api/ask RAG endpoint (answer generation).
ANTHROPIC_API_KEY=

# Optional: overrides the default Claude model used for answer synthesis
# (defaults to claude-haiku-4-5-20251001 to keep per-query cost low).
# ANTHROPIC_MODEL=claude-sonnet-5

# Required for scripts/embed.mjs (embedding the corpus) and for the
# /api/ask endpoint (embedding the visitor's question at query time).
VOYAGE_API_KEY=
